# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Gnani Speech APIs (Prisma STT + Timbre TTS) — from the Gnani APIs dashboard
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai

# Reasoning model. Evon is used whenever EVON_BASE_URL is set; otherwise Gemini
# stands in. Force one with REASONING_PROVIDER=evon|gemini.
REASONING_PROVIDER=

# Gemini stand-in (free tier key from https://aistudio.google.com/apikey).
# Free-tier prompts may be used by Google to improve its products: demo data only.
GEMINI_API_KEY=
# GEMINI_MODEL answers every call (turns, read-back, review). The fallback is
# tried once when it is overloaded, rate-limited or hangs.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Evon v3.3 behind any OpenAI-compatible server (see docs/evon-setup.md).
# Hugging Face Inference Endpoint: https://<endpoint>.endpoints.huggingface.cloud/v1
EVON_BASE_URL=
# For Hugging Face endpoints, use a Hugging Face read token (hf_...)
EVON_API_KEY=
# For Hugging Face endpoints, use the endpoint name
EVON_MODEL=model

# vLLM/SGLang accept `chat_template_kwargs` to toggle Evon's reasoning trace.
# Set to false only if the endpoint rejects unknown request fields.
EVON_SEND_CHAT_TEMPLATE_KWARGS=true

# Per-visitor API limits protect the demo's quotas. On by default in production,
# off in development. Set to "on" to try them locally or "off" to disable.
RATE_LIMIT=

# Hugging Face read token (hf_...). Authenticates calls to ZeroGPU Spaces so they
# use your account's daily GPU quota instead of the smaller anonymous pool.
HF_TOKEN=
